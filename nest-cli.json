{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "public/swagger.html",
        "outDir": "dist"
      },
      {
        "include": "public/swagger-ui.css",
        "outDir": "dist"
      },
      {
        "include": "public/swagger-ui-bundle.js",
        "outDir": "dist"
      },
      {
        "include": "public/swagger-init.js",
        "outDir": "dist"
      }
    ]
  }
}
